@model IEnumerable<TtlLesson08.Models.TtlMember>

@{
    ViewData["Title"] = "Danh sách thành viên";
}

<div class="card p-3">
    <div class="card-header">
        <h1>@ViewData["Title"]</h1>
        <a asp-action="TtlCreate">Thêm mới</a>
    </div>

    <div class="card-body">
<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TtlUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TtlPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TtlFullname)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TtlEmail)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.TtlUserName)
            </td>
            <td>
                @Html.DisplayFor(model => item.TtlPassword)
            </td>
            <td>
                @Html.DisplayFor(model => item.TtlFullname)
            </td>
            <td>
                @Html.DisplayFor(model => item.TtlEmail)
            </td>
            <td>
               @Html.ActionLink("Sửa","TtlEdit", new {id=item.TtlMemberId})
               @Html.ActionLink("Xem chi tiết","TtlDetails", new {id=item.TtlMemberId })
               @Html.ActionLink("Delete","Delete", new {id=item.TtlMemberId })
            </td>
        </tr>
}
    </tbody>
</table>

</div>