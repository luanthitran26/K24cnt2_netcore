@model TtlLesson08.Models.TtlMember

@{
    ViewData["Title"] = "Sửa thông tin thành viên";
}

<form asp-action="TtlEdit" method="post">
<div class="card p-3">
            <div class="card-header">
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="card-body">

        <div class="row">
            <div class="col-md-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="TtlMemberId" class="control-label"></label>
                        <input asp-for="TtlMemberId" class="form-control" />
                        <span asp-validation-for="TtlMemberId" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="TtlUserName" class="control-label"></label>
                        <input asp-for="TtlUserName" class="form-control" />
                        <span asp-validation-for="TtlUserName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="TtlPassword" class="control-label"></label>
                        <input asp-for="TtlPassword" class="form-control" />
                        <span asp-validation-for="TtlPassword" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="TtlFullname" class="control-label"></label>
                        <input asp-for="TtlFullname" class="form-control" />
                        <span asp-validation-for="TtlFullname" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="TtlEmail" class="control-label"></label>
                        <input asp-for="TtlEmail" class="form-control" />
                        <span asp-validation-for="TtlEmail" class="text-danger"></span>
                    </div>
            
            </div>
        </div>
      </div>
      <div class="card-footer">
           <div class="form-group">
               <input type="submit" value="Cập nhật " class="btn btn-primary" />
               <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
           </div>
        </div>
</div>    
 </form>